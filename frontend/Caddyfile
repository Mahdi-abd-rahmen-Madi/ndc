:80 {
    root * /srv
    encode zstd gzip

    # Long-term immutable caching for Vite hashed assets
    @hashedAssets {
        path /assets/*
    }
    header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

    # Standard static assets
    @staticFiles {
        path *.ico *.png *.jpg *.jpeg *.svg *.woff *.woff2 *.ttf *.eot *.json
    }
    header @staticFiles Cache-Control "public, max-age=86400"

    # HTML should always revalidate
    @html {
        path /index.html /
    }
    header @html Cache-Control "no-cache, must-revalidate"

    # SPA routing fallback
    try_files {path} /index.html
    file_server
}

