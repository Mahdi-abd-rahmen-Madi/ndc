# Caddyfile for NDC (Go-native Reverse Proxy, Edge Compression & Direct Media Serving)
# Automatically provides HTTPS, HTTP/2, HTTP/3, and Zstandard/Gzip compression.

{
    email admin@heliosys.io
    auto_https off
}

# Reusable backend proxy snippet
(backend_proxy) {
    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Reusable WebSocket hub proxy snippet (Go ws-hub service)
(ws_hub_proxy) {
    reverse_proxy ws-hub:8081 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Reusable IGN BDTOPO vector tile proxy (offloads tile fetching & caching from Django)
(bdtopo_tile_proxy) {
    @bdtopo path_regexp bdtopo ^/api/geodata/bdtopo-tiles/(\d+)/(\d+)/(\d+)/?$
    handle @bdtopo {
        rewrite * /tms/1.0.0/BDTOPO/{re.bdtopo.1}/{re.bdtopo.2}/{re.bdtopo.3}.pbf
        reverse_proxy https://data.geopf.fr {
            header_up Host data.geopf.fr
            header_down Cache-Control "public, max-age=86400, immutable"
        }
    }
}

# Reusable static GeoJSON handler:
# Serves large static coastline GeoJSON directly at Go speed if /srv/data is mounted,
# otherwise proxies cleanly to Django backend.
(static_geodata_handler) {
    @coastline_file file {
        root /srv/data
        try_files france_coastline.geojson
    }
    @coastline_path path /api/geodata/regions/coastline /api/geodata/regions/coastline/
    handle @coastline_path {
        handle @coastline_file {
            root * /srv/data
            rewrite * /france_coastline.geojson
            header Content-Type "application/json"
            header Cache-Control "public, max-age=86400, immutable"
            file_server
        }
        handle {
            import backend_proxy
        }
    }

    @coastline_buf_file file {
        root /srv/data
        try_files france_coastline_buffer_1km.geojson
    }
    @coastline_buf_path path /api/geodata/regions/coastline_buffer /api/geodata/regions/coastline_buffer/
    handle @coastline_buf_path {
        handle @coastline_buf_file {
            root * /srv/data
            rewrite * /france_coastline_buffer_1km.geojson
            header Content-Type "application/json"
            header Cache-Control "public, max-age=86400, immutable"
            file_server
        }
        handle {
            import backend_proxy
        }
    }
}

# Reusable media serving snippet:
# Serves /media/* directly at native Go speed if mounted at /srv/media,
# otherwise proxies cleanly to Django backend.
(media_handler) {
    handle_path /media/* {
        @has_local_media file {
            root /srv/media
        }
        handle @has_local_media {
            root * /srv/media
            header Content-Security-Policy "frame-ancestors 'self' https://ndc.heliosys.io"
            header Cache-Control "public, max-age=3600"
            file_server
        }
        handle {
            rewrite * /media{uri}
            import backend_proxy
        }
    }
}

# Cloudflare Tunnel API & Real-Time Edge (:8008)
# Terminates HTTP/WS compression and static/media/tile offloading before Gunicorn/ws-hub.
:8008 {
    encode zstd gzip

    import bdtopo_tile_proxy
    import static_geodata_handler
    import media_handler

    handle /ws/* {
        import ws_hub_proxy
    }
    handle {
        import backend_proxy
    }
}
