# Caddyfile for NDC (Go-native Reverse Proxy, Edge Compression & Direct Media Serving)
# Automatically provides HTTPS, HTTP/2, HTTP/3, and Zstandard/Gzip compression.

{
    email admin@heliosys.io
}

# Reusable backend proxy snippet
(backend_proxy) {
    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Reusable media serving snippet:
# Serves /media/* directly at native Go speed if mounted at /srv/media,
# otherwise proxies cleanly to Django backend.
(media_handler) {
    handle_path /media/* {
        @has_local_media file {
            root /srv/media
        }
        handle @has_local_media {
            root * /srv/media
            header Content-Security-Policy "frame-ancestors 'self' https://ndc.heliosys.io"
            header Cache-Control "public, max-age=3600"
            file_server
        }
        handle {
            rewrite * /media{uri}
            import backend_proxy
        }
    }
}

# Production Frontend & Reverse Proxy
ndc.heliosys.io {
    encode zstd gzip

    handle /api/* {
        import backend_proxy
    }
    handle /admin/* {
        import backend_proxy
    }
    handle /static/* {
        import backend_proxy
    }
    handle /ws/* {
        import backend_proxy
    }
    import media_handler

    # All other traffic directed to frontend container
    handle {
        reverse_proxy frontend:80
    }
}

# Production Backend API Domain
api-ndc.heliosys.io {
    encode zstd gzip

    import media_handler

    handle {
        import backend_proxy
    }
}

# Local development / Docker host fallback (e.g. http://localhost)
:80 {
    encode zstd gzip

    handle /api/* {
        import backend_proxy
    }
    handle /admin/* {
        import backend_proxy
    }
    handle /static/* {
        import backend_proxy
    }
    handle /ws/* {
        import backend_proxy
    }
    import media_handler

    handle {
        reverse_proxy frontend:80
    }
}
