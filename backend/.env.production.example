# ==============================================================================
# NDC Production Environment Configuration Template
# Copy this file to .env.production and adjust the values accordingly.
# Keep the production .env.production file secure and out of version control!
# ==============================================================================

# Django Core Security Settings
SECRET_KEY=generate-a-strong-random-key-here-keep-secret
DEBUG=False
ALLOWED_HOSTS=ndc.yourdomain.com,127.0.0.1,192.168.122.1

# Security Cookie Settings (Set to True if deploying behind HTTPS/SSL)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Database Settings (Production PostgreSQL with PostGIS)
DATABASE_URL=postgresql://ndc_prod_user:strong_password_here@localhost:5432/ndc_prod_db

# alternative manual DB configuration variables (if needed)
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=ndc_prod_db
DB_USER=ndc_prod_user
DB_PASSWORD=strong_password_here
DB_HOST=localhost
DB_PORT=5432

# JWT Authentication Security Settings
JWT_SECRET_KEY=generate-a-strong-random-jwt-key-here-keep-secret
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# CORS Allowed Origins (Comma-separated list of domains allowed to request API)
CORS_ALLOWED_ORIGINS=https://ndc.yourdomain.com

# Django Admin Credentials (Initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=ChangeMeWithStrongPassword123!

# Geographic Data Storage Paths
# Make sure the running process has read/write permissions to these directories
GEODATA_ROOT=/var/lib/ndc/geodata
TILE_CACHE_DIR=/var/lib/ndc/tile_cache

# Autodesk Platform Services (APS) Integration
APS_CLIENT_ID=your-aps-client-id
APS_CLIENT_SECRET=your-aps-client-secret
APS_CALLBACK_URL=https://ndc.yourdomain.com/api/aps/callback

# Autodesk VM Worker Configuration
# WORKER_BASE_URL: URL used by backend to dispatch jobs to FastAPI worker
WORKER_BASE_URL=http://192.168.122.x:8001
# WORKER_SHARE_DIR: Absolute mount path to the KVM shared directory on the host
WORKER_SHARE_DIR=/var/lib/ndc/worker_share
